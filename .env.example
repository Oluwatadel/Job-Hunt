# Use HTTPS behind your reverse proxy in production. Never commit real secrets.
APP_URL=http://localhost:3000
PORT=3000
DATABASE_URL=postgres://jobhunt:change-me@localhost:5432/jobhunt
JWT_SECRET=replace-with-64-random-characters
OWNER_EMAIL=oluwatobiadelesi@gmail.com
OWNER_NAME=Oluwatobi
# db:migrate creates the owner with this password only on a fresh database.
OWNER_PASSWORD=

# Google identity sign-in (also works outside Floot; callback /_api/auth/oauth_callback)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
# Separate Google client for Drive/Gmail connection; callback /__runtime/google/callback
GOOGLE_INTEGRATION_CLIENT_ID=
GOOGLE_INTEGRATION_CLIENT_SECRET=

# Your own Stripe account outside Floot. Use sk_test/pk_test locally; sk_live/pk_live in production.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook: APP_URL/_api/payments/event. Enable subscription + invoice events.

# OpenAI-compatible Responses API, for AI matching/profile extraction/drafts.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Outbound password reset mail (use SMTP provider credentials).
SMTP_URL=
MAIL_FROM=
# Optional browser push; generate a new VAPID pair for your own deployment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:oluwatobiadelesi@gmail.com
# Worker and scheduled jobs run only when enabled. Keep one replica unless adapting realtime.
ENABLE_SCHEDULER=false
